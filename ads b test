<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>PRG Aircraft Photo Test</title>

<style>

body{
    margin:0;
    padding:24px;
    background:#07111f;
    color:white;
    font-family:Arial,Helvetica,sans-serif;
}

h1{
    margin:0 0 6px;
}

.subtitle{
    color:#9bc7e8;
    margin-bottom:22px;
}

.panel{
    background:#0d1c2d;
    border:1px solid #28506f;
    border-radius:10px;
    padding:18px;
    margin-bottom:18px;
}

.aircraft-row{
    padding:11px;
    margin:6px 0;
    background:#142b42;
    border-radius:7px;
    cursor:pointer;
}

.aircraft-row:hover{
    background:#1d4263;
}

.selected{
    border:2px solid #4db8ff;
}

#photo{
    display:none;
    max-width:430px;
    max-height:280px;
    border-radius:9px;
    margin-top:15px;
    box-shadow:0 4px 18px rgba(0,0,0,.45);
}

#photoStatus{
    color:#9bc7e8;
    margin-top:10px;
}

#credit{
    margin-top:8px;
    font-size:13px;
    color:#bfc9d2;
}

#apiRaw{
    white-space:pre-wrap;
    word-break:break-word;
    background:#03080d;
    color:#8dff9d;
    padding:14px;
    border-radius:7px;
    font-family:Consolas,monospace;
    font-size:13px;
}

</style>
</head>

<body>

<h1>PRG AIRCRAFT PHOTO TEST</h1>

<div class="subtitle">
Click an aircraft to look for a photo of that exact registration.
</div>


<div class="panel">

<h2>Aircraft near PRG</h2>

<div id="aircraftList">
Waiting for ADS-B feed...
</div>

</div>


<div class="panel">

<h2 id="selectedAircraft">
No aircraft selected
</h2>

<div id="photoStatus">
Select an aircraft above.
</div>

<a
    id="photoLink"
    target="_blank"
    rel="noopener"
>

<img id="photo">

</a>

<div id="credit"></div>

</div>


<div class="panel">

<h2>Photo API response</h2>

<pre id="apiRaw">
Nothing requested yet.
</pre>

</div>


<script>

const AIRCRAFT_API =
"https://mikeaircraft-9hkn-186rknjwy-mikeplanes.vercel.app/api/aircraft";


/*
   IMPORTANT:

   This is the new photo API
   we created in Vercel.

   Use the stable project URL,
   not a temporary deployment URL.
*/

const PHOTO_API =
"https://mikeaircraft-9hkn-186rknjwy-mikeplanes.vercel.app/api/photo";


const PRG={
    lat:50.1008,
    lon:14.2600
};


let selectedId=null;


/* =========================
   DISTANCE
========================= */

function distanceKm(lat1,lon1,lat2,lon2){

    const R=6371;

    const dLat=
        (lat2-lat1)*Math.PI/180;

    const dLon=
        (lon2-lon1)*Math.PI/180;

    const a=
        Math.sin(dLat/2)**2
        +
        Math.cos(lat1*Math.PI/180)
        *
        Math.cos(lat2*Math.PI/180)
        *
        Math.sin(dLon/2)**2;

    return R*2*
        Math.atan2(
            Math.sqrt(a),
            Math.sqrt(1-a)
        );
}


/* =========================
   HELPERS
========================= */

function aircraftId(ac){

    return (
        ac.hex ||
        ac.r ||
        (ac.flight||"").trim()
    );
}


function callsign(ac){

    return (
        (ac.flight||"")
        .trim()
        ||
        "NO CALLSIGN"
    );
}


/* =========================
   PHOTO LOOKUP
========================= */

async function lookupPhoto(ac){

    const hex=
        (ac.hex||"")
        .trim()
        .toLowerCase();


    const photo=
        document.getElementById(
            "photo"
        );


    const status=
        document.getElementById(
            "photoStatus"
        );


    const credit=
        document.getElementById(
            "credit"
        );


    const link=
        document.getElementById(
            "photoLink"
        );


    const raw=
        document.getElementById(
            "apiRaw"
        );


    photo.style.display="none";

    photo.removeAttribute("src");

    credit.textContent="";

    link.removeAttribute("href");


    if(!hex){

        status.textContent=
            "No hex code available for this aircraft.";

        return;
    }


    status.textContent=
        "Looking for photo of "+
        (ac.r||hex)+
        "...";


    try{

        const response=
            await fetch(

                PHOTO_API+
                "?hex="+
                encodeURIComponent(hex),

                {
                    cache:"no-store"
                }

            );


        const data=
            await response.json();


        raw.textContent=
            JSON.stringify(
                data,
                null,
                2
            );


        /*
           Airport-Data response:

           {
             status:200,
             count:1,
             data:[
               {
                 image:"...",
                 link:"...",
                 photographer:"..."
               }
             ]
           }
        */


        if(
            data.status!==200
            ||
            !data.data
            ||
            !data.data.length
        ){

            status.textContent=
                "No photo available for "+
                (ac.r||hex);

            return;
        }


        const result=
            data.data[0];


        if(!result.image){

            status.textContent=
                "Photo record found, but no thumbnail was returned.";

            return;
        }


        photo.src=
            result.image;


        photo.style.display=
            "block";


        status.textContent=
            "PHOTO FOUND — "+
            (ac.r||hex);


        credit.textContent=

            result.photographer

            ?

            "Photo: "+
            result.photographer+
            " / Airport-Data.com"

            :

            "Photo: Airport-Data.com";


        if(result.link)
            link.href=
                result.link;

    }

    catch(error){

        status.textContent=
            "Photo lookup failed: "+
            error.message;


        raw.textContent=
            String(error);
    }
}


/* =========================
   LOAD AIRCRAFT
========================= */

async function updateAircraft(){

    try{

        const response=
            await fetch(

                AIRCRAFT_API+
                "?t="+
                Date.now(),

                {
                    cache:"no-store"
                }

            );


        const data=
            await response.json();


        const aircraft=
            (data.ac||[])

            .filter(ac=>

                Number.isFinite(
                    Number(ac.lat)
                )

                &&

                Number.isFinite(
                    Number(ac.lon)
                )

            );


        aircraft.sort((a,b)=>{

            const da=
                distanceKm(
                    Number(a.lat),
                    Number(a.lon),
                    PRG.lat,
                    PRG.lon
                );


            const db=
                distanceKm(
                    Number(b.lat),
                    Number(b.lon),
                    PRG.lat,
                    PRG.lon
                );


            return da-db;

        });


        const list=
            document.getElementById(
                "aircraftList"
            );


        list.innerHTML="";


        for(const ac of aircraft){

            const d=
                distanceKm(
                    Number(ac.lat),
                    Number(ac.lon),
                    PRG.lat,
                    PRG.lon
                );


            if(d>25)
                continue;


            /*
               Hide obvious airport
               ground vehicles and towers
               from this photo test.
            */

            const type=
                (ac.t||"")
                .trim()
                .toUpperCase();


            const reg=
                (ac.r||"")
                .trim()
                .toUpperCase();


            if(
                type==="TWR"
                ||
                type==="GND"
                ||
                type==="EMER"
                ||
                reg==="TWR"
                ||
                reg==="GND"
            )
                continue;


            const id=
                aircraftId(ac);


            if(!id)
                continue;


            const row=
                document.createElement(
                    "div"
                );


            row.className=
                "aircraft-row";


            if(id===selectedId)
                row.classList.add(
                    "selected"
                );


            row.textContent=

                callsign(ac)
                +
                "  |  "
                +
                (ac.r||"NO REG")
                +
                "  |  "
                +
                (ac.desc||ac.t||"")
                +
                "  |  "
                +
                d.toFixed(1)
                +
                " km";


            row.onclick=()=>{

                selectedId=id;


                document
                .getElementById(
                    "selectedAircraft"
                )
                .textContent=

                    callsign(ac)
                    +
                    " — "
                    +
                    (ac.r||"")
                    +
                    " — "
                    +
                    (ac.desc||ac.t||"");


                lookupPhoto(ac);

            };


            list.appendChild(
                row
            );
        }

    }

    catch(error){

        document
        .getElementById(
            "aircraftList"
        )
        .textContent=

            "ADS-B error: "+
            error.message;

    }
}


updateAircraft();


setInterval(
    updateAircraft,
    10000
);

</script>

</body>
</html>
